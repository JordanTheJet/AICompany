# Application Settings
APP_NAME=AICompany Social Media Integration
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Twitter/X API Credentials
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Instagram API Credentials
# Get these from: https://developers.facebook.com/apps/
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_ID=your_session_id

# TikTok API Credentials
# Get these from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Database (optional)
DATABASE_URL=sqlite:///./aicompany.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-for-credentials

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
